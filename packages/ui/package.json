{
  "name": "@pawhaven/ui",
  "version": "3.0.0",
  "private": true,
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./form": {
      "types": "./build/components/form/index.d.ts",
      "import": "./build/components/form/index.js",
      "default": "./build/components/form/index.js"
    },
    "./index.css": "./index.css"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src .storybook --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "storybook": "storybook dev --config-dir .storybook --host 0.0.0.0 --port 6006",
    "build-storybook": "storybook build --config-dir .storybook --output-dir dist/storybook-static",
    "test-storybook": "vitest run --config .storybook/vitest.config.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@pawhaven/design-system": "workspace:*",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "8.6.0",
    "lottie-react": "^3.1.0",
    "lucide-react": "^0.545.0",
    "react-hook-form": "^7.64.0",
    "react-phone-number-input": "^3.4.18",
    "tailwind-merge": "3.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@pawhaven/eslint-config": "workspace:*",
    "@pawhaven/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "eslint-plugin-storybook": "10.6.2"
  }
}
