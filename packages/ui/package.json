{
  "name": "@pawhaven/ui",
  "version": "3.0.0",
  "private": true,
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./form": {
      "types": "./build/components/Form/index.d.ts",
      "import": "./build/components/Form/index.js",
      "default": "./build/components/Form/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "sideEffects": false,
  "dependencies": {
    "@pawhaven/design-system": "workspace:*",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "8.6.0",
    "lottie-react": "^3.1.0",
    "lucide-react": "^0.545.0",
    "react-hook-form": "^7.64.0",
    "react-phone-number-input": "^3.4.18",
    "tailwind-merge": "3.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@pawhaven/eslint-config": "workspace:*",
    "@pawhaven/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
