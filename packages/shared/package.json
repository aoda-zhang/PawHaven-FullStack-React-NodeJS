{
  "name": "@pawhaven/shared",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/types/index.js",
      "require": "./dist/cjs/types/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/esm/constants/index.js",
      "require": "./dist/cjs/constants/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js"
    }
  },
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('node:fs').writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}')\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "pnpm run build:esm && pnpm run build:cjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.cjs.json && tsc --noEmit -p tsconfig.esm.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@pawhaven/eslint-config": "workspace:*",
    "@pawhaven/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.11",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
