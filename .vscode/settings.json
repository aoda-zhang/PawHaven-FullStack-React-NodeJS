{
  // --- 🧹 Basic formatting & save rules ---
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit"
  },

  // --- 🧠 TypeScript settings ---
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // --- 💄 ESLint + Prettier integration ---
  "eslint.validate": [
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact"
  ],
  "prettier.requireConfig": true,

  // --- 🎨 Tailwind CSS support ---
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.experimental.classRegex": [
    ["className\\s*:\\s*['\"]([^'\"]*)['\"]"]
  ],
  "tailwindCSS.experimental.configFile": "packages/theme/globalTailwind.css",
  "tailwindCSS.includeLanguages": {
    "javascript": "javascript",
    "javascriptreact": "javascript",
    "typescript": "typescript",
    "typescriptreact": "typescript"
  },

  // --- 💬 Quick suggestions ---
  "editor.quickSuggestions": {
    "strings": true
  },

  // --- 🧭 Path Autocomplete: alias path completions ---
  "path-autocomplete.pathMappings": {
    "@pawhaven/ui/*": "${workspaceFolder}/packages/ui/*",
    "@pawhaven/frontend-core/*": "${workspaceFolder}/packages/frontend-core/*",
    "@pawhaven/backend-core": "${workspaceFolder}/packages/backend-core",
    "@pawhaven/backend-core/constants": "${workspaceFolder}/packages/backend-core/common/constants",
    "@pawhaven/backend-core/decorators": "${workspaceFolder}/packages/backend-core/common/decorators",
    "@pawhaven/backend-core/types": "${workspaceFolder}/packages/backend-core/common/types",
    "@pawhaven/backend-core/utils": "${workspaceFolder}/packages/backend-core/common/utils",
    "@pawhaven/backend-core/setup": "${workspaceFolder}/packages/backend-core/infrastructure/bootstrap",
    "@pawhaven/backend-core/middlewares": "${workspaceFolder}/packages/backend-core/infrastructure/middleware",
    "@pawhaven/backend-core/trace": "${workspaceFolder}/packages/backend-core/infrastructure/observability/tracing",
    "@pawhaven/backend-core/config-module": "${workspaceFolder}/packages/backend-core/modules/config",
    "@pawhaven/backend-core/internal-jwt": "${workspaceFolder}/packages/backend-core/modules/internal-jwt"
  },
  "path-autocomplete.extensionOnImport": true,
  "[proto3]": {
    "editor.defaultFormatter": "zxh404.vscode-proto3"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "chat.tools.terminal.autoApprove": {
    "rg": true,
    "head": true,
    "grep": true
  },
  "timezoneTheme.nightTheme": "Quiet Light",
  "pendant.autoGenerateSessionNames": true,
  "pendant.sessionNameGeneration": {}
}
