{
  "private": "true",
  "name": "@pawhaven/core-service",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "pnpm run prisma:generate-mongodb",
    "dev": "nest start --watch",
    "prebuild": "pnpm run prisma:generate-mongodb",
    "build": "nest build",
    "install:core-service": "pnpm --filter=@pawhaven/core-service... install",
    "turbo:build": "turbo run build --filter=@pawhaven/core-service --env-mode=loose",
    "start": "node dist/main.js",
    "prisma:generate-mongodb": "prisma generate --schema=./src/prisma/mongodb/schema.prisma",
    "prisma:db-push": "prisma db push --schema=./src/prisma/mongodb/schema.prisma",
    "prisma:seed-mongodb": "ts-node --project tsconfig.json -r tsconfig-paths/register src/prisma/mongodb/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "@pawhaven/backend-core": "workspace:*",
    "@pawhaven/shared": "workspace:*",
    "@prisma/client": "^6.19.1",
    "@types/express": "^5.0.3",
    "axios": "^1.12.2",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "express": "5.2.1",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.0",
    "mongoose": "^8.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@pawhaven/eslint-config": "workspace:*",
    "@pawhaven/tsconfig": "workspace:*",
    "@swc/core": "^1.16.2",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.4",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^6.19.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.10"
  }
}
