DOCUMENT_SERVICE_MONGODB=your-mongodb-url
INTERNAL_JWT_PUBLIC_KEY=your-shared-internal-jwt-public-key
EMAIL_SMTP_HOST=your-smtp-host
EMAIL_SMTP_USER=your-user
EMAIL_SMTP_PASSWORD=your-password
# File storage is selected by "storage.provider" in src/config/<env>/env/index.json.
# The Vercel Blob adapter needs the token below.
DOCUMENT_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# OIDC (recommended on Vercel): VERCEL_OIDC_TOKEN is injected automatically.
# Set the store id and omit DOCUMENT_READ_WRITE_TOKEN in that environment.
DOCUMENT_STORE_ID=
