{
  "extends": "@pawhaven/tsconfig/node",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["node", "multer"],
    "paths": {
      "@PDF/*": ["./src/modules/pdf/*"],
      "@Email/*": ["./src/modules/email/*"],
      "@Files/*": ["./src/modules/files/*"]
    }
  },
  "include": ["src"]
}
