{
  "private": "true",
  "name": "@pawhaven/document-service",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node ./scripts/dev-pdf-watch.mjs",
    "prebuild": "node ./scripts/prebuild-pdf-style.mjs",
    "sync:design-tokens": "node ./scripts/sync-design-tokens.mjs",
    "build": "nest build",
    "install:document-service": "pnpm --filter=@pawhaven/document-service... install",
    "turbo:build": "turbo run build --filter=@pawhaven/document-service --env-mode=loose",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@pawhaven/backend-core": "workspace:*",
    "@pawhaven/design-system": "workspace:*",
    "@pawhaven/i18n": "workspace:*",
    "@pawhaven/shared": "workspace:*",
    "@react-email/components": "^0.5.6",
    "@sparticuz/chromium": "^153.0.0",
    "@types/express": "^5.0.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "axios": "^1.12.2",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "i18next": "^25.6.0",
    "nodemailer": "^7.0.11",
    "puppeteer": "^24.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@pawhaven/eslint-config": "workspace:*",
    "@pawhaven/tsconfig": "workspace:*",
    "@rspack/core": "^2.2.3",
    "@swc/core": "^1.16.2",
    "@tailwindcss/cli": "^4.1.14",
    "@types/node": "^24.7.1",
    "@types/nodemailer": "^6.4.20",
    "tailwindcss": "^4.1.14",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.10",
    "webpack-node-externals": "^3.0.0"
  }
}
