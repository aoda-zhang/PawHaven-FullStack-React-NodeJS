{
  "http": {
    "env": "dev",
    "port": 8083,
    "maxJsonBodySize": "100mb",
    "prefix": "document-service",
    "timeout": 5000,
    "retryCount": 3,
    "retryDelay": 500
  },
  "swagger": {
    "title": "管理后台",
    "version": 1,
    "prefix": "api-docs",
    "description": "管理后台接口文档"
  },
  "dbConnections": [
    {
      "enable": true,
      "options": {
        "name": "DOCUMENT_SERVICE_DB",
        "uri": "${DOCUMENT_SERVICE_MONGODB}"
      }
    }
  ],
  "cors": {
    "allowedHeaders": [
      "X-timestamp",
      "Access-Token",
      "Accept",
      "Content-Type",
      "X-Sign",
      "x-locale"
    ],
    "origin": ["http://localhost:3001"],
    "credentials": true,
    "optionsSuccessStatus": 204,
    "methods": ["GET", "POST", "PUT", "OPTIONS"]
  },
  "internalJwt": {
    "enabled": true,
    "audience": "document-service",
    "publicKeys": {
      "internal-v1": "${INTERNAL_JWT_PUBLIC_KEY}"
    },
    "ttlSeconds": 45,
    "clockSkewSeconds": 30
  },
  "email": {
    "from": "no-reply@pawhaven.work",
    "host": "${EMAIL_SMTP_HOST}",
    "port": 587,
    "user": "${EMAIL_SMTP_USER}",
    "password": "${EMAIL_SMTP_PASSWORD}",
    "tls": {
      "ciphers": "HIGH"
    }
  }
}
