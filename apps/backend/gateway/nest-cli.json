{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "rspack",
      "options": { "configPath": "rspack.config.mjs" }
    },
    "watchAssets": true,
    "assets": [
      {
        "include": "config/**",
        "watchAssets": true
      },
      {
        "include": ".env*",
        "watchAssets": true
      }
    ]
  },
  "generateOptions": {
    "spec": false
  }
}
