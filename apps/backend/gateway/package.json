{
  "$schema": "http://json.schemastore.org/package",
  "private": true,
  "name": "@pawhaven/gateway",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "turbo:build": "turbo run build --filter=@pawhaven/gateway --env-mode=loose",
    "install:gateway": "pnpm --filter=@pawhaven/gateway... install",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --ignore-pattern \"dist/**\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "@pawhaven/backend-core": "workspace:*",
    "@pawhaven/shared": "workspace:*",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "csurf": "^1.11.0",
    "dayjs": "^1.11.18",
    "express": "5.2.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "mongoose": "^8.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "turbo": "^2.7.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@pawhaven/eslint-config": "workspace:*",
    "@pawhaven/tsconfig": "workspace:*",
    "@rspack/core": "^2.2.3",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.7.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.10",
    "webpack-node-externals": "^3.0.0"
  }
}
