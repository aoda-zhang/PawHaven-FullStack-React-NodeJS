{
  "http": {
    "env": "dev",
    "port": 8080,
    "maxJsonBodySize": "100mb",
    "prefix": "api",
    "timeout": 15000,
    "retryCount": 3,
    "retryDelay": 500,
    "trustProxy": 0
  },
  "swagger": {
    "title": "管理后台",
    "version": 1,
    "prefix": "api-docs",
    "description": "管理后台接口文档"
  },
  "auth": {
    "jwtSecret": "${JWT_SECRET}",
    "jwtExpiresIn": 300,
    "jwtClockTolerance": 30,
    "jwtRefreshFallbackSeconds": 60,
    "jwtRefreshWindowPercentage": 0.2,
    "refreshTokenExpiresIn": 604800,
    "refreshTokenRotationWindowSeconds": 86400,
    "sessionExpiresIn": 2592000
  },
  "internalJwt": {
    "enabled": false,
    "audience": "gateway",
    "ttlSeconds": 45,
    "clockSkewSeconds": 30,
    "keyId": "internal-v1",
    "privateKey": "${INTERNAL_JWT_PRIVATE_KEY}"
  },
  "throttle": {
    "ttlMs": 60000,
    "limit": 300,
    "authTtlMs": 60000,
    "authLimit": 10
  },
  "microServices": [
    {
      "name": "core-service",
      "enable": true,
      "options": {
        "host": "${CORE_SERVICE_HOST}",
        "port": 8081,
        "gatewayPrefix": "/api/core",
        "pathRewrite": "/core-service"
      }
    },
    {
      "name": "auth-service",
      "enable": true,
      "options": {
        "host": "${AUTH_SERVICE_HOST}",
        "port": 8082,
        "gatewayPrefix": "/api/auth",
        "pathRewrite": "/auth-service"
      }
    },
    {
      "name": "document-service",
      "enable": true,
      "options": {
        "host": "${DOCUMENT_SERVICE_HOST}",
        "port": 8083,
        "gatewayPrefix": "/api/document",
        "pathRewrite": "/document-service"
      }
    }
  ],
  "cors": {
    "allowedHeaders": [
      "X-timestamp",
      "Access-Token",
      "Accept",
      "Content-Type",
      "X-Sign",
      "x-locale"
    ],
    "origin": ["http://localhost:3001"],
    "credentials": true,
    "optionsSuccessStatus": 204,
    "methods": ["GET", "POST", "PUT", "OPTIONS"]
  },
  "dbConnections": [
    {
      "enable": true,
      "options": {
        "name": "CORE_SERVICE_DB",
        "uri": "${CORE_SERVICE_DB}"
      }
    }
  ]
}
