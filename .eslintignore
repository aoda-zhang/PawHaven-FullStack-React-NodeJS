# Ignore build outputs and dependencies
node_modules/
dist/
build/
coverage/
.next/
out/

# Ignore config and generated files
*.config.js
*.config.cjs
*.config.mjs
*.min.js
*.d.ts
# NestJS tool config — kebab-case, must not be renamed
**/nest-cli.json

# Ignore environment and tooling folders
.husky/
.vscode/
.github/
scripts/
harness-core/
logs/

# Ignore specific monorepo folders that don't require linting
libs/tsconfig
libs/eslint-config
**/config/**
packages/design-system/figma

# Generated runtime output — written only by an adapter's generator. Linting a generated file either
# duplicates the canonical check or, when a rule is fixable, edits the output and breaks the drift check.
.pi/

# Ignore all test files from linting (verification covered by vitest, not eslint)
**/*.test.ts
**/*.test.tsx
**/*.test.js
**/*.test.jsx
**/*.spec.ts
**/*.spec.tsx
**/*.spec.js
**/*.spec.jsx
**/tests/**
**/__tests__/**
**/*.setup.ts
**/*.setup.tsx
vitest.config.ts
playwright.config.ts

**/src/prisma/mongodb/client/**
