# Ignore build outputs and dependencies
node_modules/
dist/
build/
coverage/
.next/
out/

# Ignore config and generated files
*.config.js
*.config.cjs
*.config.mjs
*.min.js
*.d.ts

# Ignore environment and tooling folders
.husky/
.vscode/
.github/
scripts/
logs/

# Ignore specific monorepo folders that don't require linting
packages/i18n
libs/tsconfig
libs/eslint-config
**/config/**
packages/design-system/figma

# Ignore all test files from linting (verification covered by vitest, not eslint)
**/*.test.ts
**/*.test.tsx
**/*.test.js
**/*.test.jsx
**/*.spec.ts
**/*.spec.tsx
**/*.spec.js
**/*.spec.jsx
**/tests/**
**/__tests__/**
**/*.setup.ts
**/*.setup.tsx
vitest.config.ts
playwright.config.ts
