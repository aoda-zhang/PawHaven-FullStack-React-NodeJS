{
  "name": "@pawhaven/ui-storybook",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive Storybook catalogue for every exported PawHaven UI component.",
  "scripts": {
    "storybook": "storybook dev --config-dir .storybook --host 0.0.0.0 --port 6006",
    "build-storybook": "storybook build --config-dir .storybook --output-dir storybook-static"
  },
  "dependencies": {
    "@pawhaven/ui": "file:../../packages/ui",
    "@pawhaven/design-system": "file:../../packages/design-system",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.64.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "9.1.5",
    "@storybook/addon-docs": "9.1.5",
    "@storybook/react-vite": "9.1.5",
    "@tailwindcss/vite": "4.1.14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "storybook": "9.1.5",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.1.11"
  }
}
